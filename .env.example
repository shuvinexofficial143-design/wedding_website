# Node 24+ required. Copy to .env.local; never commit actual secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Sandbox only. The code intentionally refuses production payments.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Use an absolute path on a persistent disk in deployment.
DATABASE_PATH=
UPLOAD_DIR=
# Admin needs BOTH an allowlisted email and the database admin role.
ADMIN_EMAILS=
# Only for the one-time CLI; remove these after provisioning.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# PostgreSQL (required on Vercel); configure privately, run npm run db:migrate.
DATABASE_URL=
# Direct connection to the same verified PREVIEW database for guarded migrations.
DATABASE_URL_UNPOOLED=
# S3-compatible private bucket. No public ACLs. Configure CORS for exact site origin.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_ENCRYPTION=
# Test/development only. Never set local storage on Vercel.
ASSET_STORAGE=s3
ASSET_LOCAL_DIR=
